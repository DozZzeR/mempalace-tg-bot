# Copy to .env for local development. Never commit the filled-in file.

# ---- Bot (apps/bot) ----
TELEGRAM_BOT_TOKEN=
# The bot's public handle or t.me link. Display only, never an auth input.
TELEGRAM_BOT=
GATEWAY_URL=http://127.0.0.1:8787

# ---- Palace Gateway (apps/gateway) ----
GATEWAY_PORT=8787
# Shared secret the bot presents to the gateway. Any long random string.
GATEWAY_TOKEN=

# State store (R-10): allowlist, project registry, per-user project sets.
STATE_DB_PATH=./data/state.sqlite

# ---- MemPalace access (D-2: MCP over streamable HTTP) ----
PALACE_URL=https://<palace-host>/mcp

# Authorization header sent to the palace, e.g. "Bearer ...".
# MUST be a credential scoped to a profile that cannot read private or family
# wings. Do not reuse a developer's full-access palace token here: our own
# deny-list should be the second line of defence, not the only one.
PALACE_AUTHORIZATION=
