# Copy to .env for local development. Never commit the filled-in file.

# ---- Bot (apps/bot) ----
TELEGRAM_BOT_TOKEN=
# The bot's public handle or t.me link. Display only, never an auth input.
TELEGRAM_BOT=
GATEWAY_URL=http://127.0.0.1:8787

# ---- Palace Gateway (apps/gateway) ----
GATEWAY_PORT=8787
# Shared secret the bot presents to the gateway. Any long random string.
GATEWAY_TOKEN=

# State store (R-10): allowlist, project registry, per-user project sets.
STATE_DB_PATH=./data/state.sqlite

# ---- MemPalace access ----
# Two transports. stdio wins whenever PALACE_COMMAND is set.
#
# stdio — the palace as a child process on the same host. Preferred once the
# gateway sits next to MemPalace: no port, no credential, nothing to leak. The
# connection's scope is set by how the process is launched rather than by a
# bearer string, e.g. PALACE_ENV=MEMPALACE_ACCESS_PROFILE=common
#
# Only the variables named in PALACE_ENV reach the child. The gateway's own
# environment holds the Telegram token and the shared secret, and none of that
# is the palace's business.
PALACE_COMMAND=
PALACE_ARGS=
PALACE_ENV=
PALACE_CWD=

# http — the palace on another host. Requires a credential; used only when
# PALACE_COMMAND is empty.
PALACE_URL=https://<palace-host>/mcp
PALACE_AUTHORIZATION=

# ---- Reasoning layer (Codex CLI) ----
# Opt-in on purpose: a half-configured box should not quietly start spending
# Codex time. Off means the bot searches with the words the person typed and
# composes no prose — it degrades, it does not fail.
#
# The model plans English search queries (MemPalace stores English, people ask
# in other languages) and composes the answer. It is given no tools.
MODEL_ENABLED=false
MODEL_NAME=gpt-5.5
MODEL_TIMEOUT_MS=120000
MODEL_PROJECT_ROOT=./data/model
MODEL_TMP_DIR=./data/model/tmp
MODEL_MAX_CONCURRENCY=1
# Absolute path beats a bare name: a supervisor's PATH is not the shell's.
MODEL_COMMAND=codex
# codex-cli fails intermittently when its model cache goes stale — see the
# comment in apps/gateway/src/model/codexModel.ts. One retry absorbs it.
MODEL_RETRIES=1

# ---- Admin surface ----
# Who the admins are — Telegram user ids, comma separated. Configuration, not
# state: nothing reachable at runtime can promote an account, and a fresh
# database still has an owner. A listed admin is admitted implicitly and sees
# every published project, so there is no bootstrap step.
ADMIN_IDS=

# Unset means there is no admin API at all, not even a locked one.
# Admin powers are not ambient: an admin sends /admin <secret> to open a
# session that expires, and the bot deletes that message immediately.
ADMIN_SECRET=
ADMIN_SESSION_TTL_MS=900000
