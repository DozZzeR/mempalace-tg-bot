# Copy to .env for local development. Never commit the filled-in file.

# ---- Bot (apps/bot) ----
TELEGRAM_BOT_TOKEN=
# The bot's public handle or t.me link. Display only, never an auth input.
TELEGRAM_BOT=
GATEWAY_URL=http://127.0.0.1:8787

# ---- Palace Gateway (apps/gateway) ----
GATEWAY_PORT=8787
# Shared secret the bot presents to the gateway. Any long random string.
GATEWAY_TOKEN=

# State store (R-10): allowlist, project registry, per-user project sets.
STATE_DB_PATH=./data/state.sqlite

# ---- MemPalace access ----
# Two transports. stdio wins whenever PALACE_COMMAND is set.
#
# stdio — the palace as a child process on the same host. Preferred once the
# gateway sits next to MemPalace: no port, no credential, nothing to leak. The
# connection's scope is set by how the process is launched rather than by a
# bearer string, e.g. PALACE_ENV=MEMPALACE_ACCESS_PROFILE=common
#
# Only the variables named in PALACE_ENV reach the child. The gateway's own
# environment holds the Telegram token and the shared secret, and none of that
# is the palace's business.
PALACE_COMMAND=
PALACE_ARGS=
PALACE_ENV=
PALACE_CWD=

# http — the palace on another host. Requires a credential; used only when
# PALACE_COMMAND is empty.
PALACE_URL=https://<palace-host>/mcp
PALACE_AUTHORIZATION=
